{
  "manifestVersion": 2,
  "id": "agent-model-plan",
  "name": "配装",
  "description": "集中管理所有角色卡的默认聊天模型与各供应商密钥，整套存成配装，随时切换",
  "version": "1.2.0",
  "entry": "index.js",
  "minAppVersion": "0.1017.0",
  "icon": "assets/icon.svg",
  "capabilities": [
    "app/agents.read",
    "app/agents.manage",
    "app/models.read",
    "app/resources.read",
    "app/provider.credentials.read",
    "app/ui.clipboard-write"
  ],
  "contributes": {
    "cards": [
      {
        "id": "presets",
        "title": "配装",
        "description": "批量查看与切换所有角色卡的默认聊天模型，并集中存放各供应商密钥。",
        "route": "/index.html",
        "realization": "page",
        "siteNavEntry": true,
        "cardForm": "structural",
        "face": {
          "image": "assets/cover.webp"
        }
      }
    ]
  }
}
